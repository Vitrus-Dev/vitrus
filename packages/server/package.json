{
  "name": "@vitrus-dev/server",
  "version": "0.11.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Single-process Vitrus server: ingest, query API, tracker and dashboard over one SQLite file.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/server.ts"
  },
  "dependencies": {
    "@vitrus-dev/core": "workspace:*",
    "@vitrus-dev/tracker": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitrus-Dev/vitrus.git",
    "directory": "packages/server"
  },
  "homepage": "https://vitrus.dev",
  "bugs": "https://github.com/Vitrus-Dev/vitrus/issues",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "web-analytics",
    "bun",
    "sqlite",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ]
}

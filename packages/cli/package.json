{
  "name": "@vitrus/cli",
  "version": "0.11.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "vitrus — self-hosted, cookie-free analytics in one process: init, site, start, digest.",
  "bin": {
    "vitrus": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "vitrus": "bun run src/cli.ts"
  },
  "dependencies": {
    "@vitrus/core": "workspace:*",
    "@vitrus/server": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitrus-Dev/vitrus.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vitrus.dev",
  "bugs": "https://github.com/Vitrus-Dev/vitrus/issues",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "web-analytics",
    "bun",
    "sqlite",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ]
}
